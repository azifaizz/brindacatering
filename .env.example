# --- Public site configuration (safe to expose in the browser) ---
VITE_SITE_URL=
VITE_BUSINESS_PHONE=
# Digits only, with country code, e.g. 919XXXXXXXXX
VITE_WHATSAPP_NUMBER=
VITE_BUSINESS_EMAIL=
# Address lines separated by | e.g. "Line 1|Line 2|City - PIN"
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_HOURS=
VITE_GOOGLE_MAPS_URL=
VITE_GOOGLE_MAPS_EMBED_URL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=

# --- Server-only secrets (never exposed to the browser) ---
# Destination that receives enquiry submissions (email provider, CRM, automation).
# Until this is set, the enquiry endpoint responds honestly that online
# enquiries are not connected yet.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_API_SECRET=
SITE_URL=

# --- Firebase Configuration ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
